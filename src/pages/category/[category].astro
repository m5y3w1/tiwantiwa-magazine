---
import Layout from '../../components/Layout.astro';

export async function getStaticPaths() {
  const validCategories = [
    'nigeria', 'diaspora', 'business', 'technology', 'culture',
    'lifestyle', 'people', 'opinions'
  ];
  return validCategories.map(cat => ({ params: { category: cat } }));
}

const { category } = Astro.params;

const postsGlob = import.meta.glob('../../../content/published/*.md');
const posts = [];

for (const path in postsGlob) {
  const slug = path.split('/').pop().replace('.md', '');
  const resolver = postsGlob[path];
  const post = await resolver();
  const postCategory = post.frontmatter.categories || [post.frontmatter.category];
  const lowerCategories = (Array.isArray(postCategory) ? postCategory : [postCategory])
    .map((c: string) => c.toLowerCase());
  if (lowerCategories.includes(category.toLowerCase())) {
    posts.push({
      slug,
      data: post.frontmatter
    });
  }
}

const categoryTitles = {
  nigeria: 'Nigeria',
  diaspora: 'Diaspora',
  business: 'Business & Money',
  technology: 'Technology',
  culture: 'Culture & Entertainment',
  lifestyle: 'Lifestyle',
  people: 'People & Profiles',
  opinions: 'Ideas & Opinions'
};

const displayName = categoryTitles[category.toLowerCase()] || category;
---

<Layout
  title={`${displayName} — TiwaNtiwa`}
  description={`Latest articles and analysis in ${displayName}.`}
>
  <main class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-16">
    <div class="text-center mb-12">
      <h1 class="text-3xl sm:text-5xl font-serif font-bold text-white tracking-tight leading-tight">
        {displayName}
      </h1>
      <p class="mt-4 text-lg text-zinc-400 max-w-2xl mx-auto">
        Stories, analysis, and insights from our {displayName.toLowerCase()} coverage.
      </p>
    </div>

    {posts.length === 0 ? (
      <div class="text-center py-20 border border-zinc-800 rounded-2xl bg-zinc-950">
        <h2 class="text-xl font-semibold text-zinc-300 mb-2">No Articles Published Yet</h2>
        <p class="text-sm text-zinc-500">We're working on new dispatches for this section. Check back soon!</p>
      </div>
    ) : (
      <ul role="list" class="space-y-8">
        {posts.map(post => {
          const postDate = new Date(post.data.date || new Date());
          const postCategories = post.data.categories || [post.data.category];
          const lowerPostCats = Array.isArray(postCategories) ? postCategories : [postCategories];

          return (
            <li key={post.slug} class="border-b border-zinc-800 pb-6">
              <article class="flex flex-col md:flex-row gap-6 items-start">
                <div class="w-full md:w-32 h-20 md:h-full flex-shrink-0 rounded-lg bg-gradient-to-br from-zinc-800 to-zinc-900 border border-zinc-800 flex items-center justify-center relative overflow-hidden">
                  <span class="font-serif text-xs text-zinc-600 tracking-widest uppercase absolute bottom-2 left-2">
                    {post.data.cover_image ? 'Cover' : 'Image'}
                  </span>
                </div>

                <div class="flex-1 min-w-0">
                  <div class="flex flex-wrap items-center gap-2 text-xs font-semibold uppercase tracking-widest text-amber-400 mb-2">
                    {lowerPostCats.map((cat, idx) => (
                      <span key={idx}>{cat}</span>
                    ))}
                    <span class="text-zinc-600">&bull;</span>
                    <time datetime={postDate.toISOString()}>
                      {postDate.toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric' })}
                    </time>
                  </div>

                  <h2 class="text-xl sm:text-2xl font-serif font-bold text-white tracking-tight mb-2 leading-snug">
                    <a href={`/posts/${post.slug}/`} class="hover:text-amber-400 transition-colors">
                      {post.data.title}
                    </a>
                  </h2>

                  {post.data.description && (
                    <p class="text-sm sm:text-base text-zinc-400 leading-relaxed mb-3 line-clamp-3">
                      {post.data.description}
                    </p>
                  )}

                  {post.data.author && (
                    <p class="text-xs text-zinc-500">
                      By <strong class="text-zinc-400">{post.data.author}</strong>
                    </p>
                  )}
                </div>
              </article>
            </li>
          );
        })}
      </ul>
    )}
  </main>
</Layout>
