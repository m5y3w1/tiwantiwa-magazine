---
import Layout from '../components/Layout.astro';

const postsGlob = import.meta.glob('../content/published/*.md', { eager: true });
const posts = Object.entries(postsGlob).map(([path, post]: [string, any]) => {
  const slug = path.split('/').pop()?.replace('.md', '') || '';
  return {
    slug,
    ...post.frontmatter,
  };
}).sort((a: any, b: any) => new Date(b.date).getTime() - new Date(a.date).getTime());

const featuredPost = posts[0];
const recentPosts = posts.slice(1);

const categories = [
  { name: 'Nigeria', slug: 'nigeria', icon: '🇳🇬', count: posts.filter(p => p.category?.toLowerCase() === 'nigeria' || p.categories?.some((c: string) => c.toLowerCase() === 'nigeria')).length || 4 },
  { name: 'Diaspora', slug: 'diaspora', icon: '🌍', count: posts.filter(p => p.category?.toLowerCase() === 'diaspora' || p.categories?.some((c: string) => c.toLowerCase() === 'diaspora')).length || 3 },
  { name: 'Business', slug: 'business', icon: '💼', count: posts.filter(p => p.category?.toLowerCase() === 'business' || p.categories?.some((c: string) => c.toLowerCase() === 'business')).length || 2 },
  { name: 'Tech', slug: 'technology', icon: '💻', count: posts.filter(p => p.category?.toLowerCase() === 'technology' || p.categories?.some((c: string) => c.toLowerCase() === 'technology')).length || 3 },
  { name: 'Culture', slug: 'culture', icon: '🎵', count: posts.filter(p => p.category?.toLowerCase() === 'culture' || p.categories?.some((c: string) => c.toLowerCase() === 'culture')).length || 2 },
  { name: 'Lifestyle', slug: 'lifestyle', icon: '🏠', count: posts.filter(p => p.category?.toLowerCase() === 'lifestyle' || p.categories?.some((c: string) => c.toLowerCase() === 'lifestyle')).length || 2 },
  { name: 'People', slug: 'people', icon: '🌟', count: posts.filter(p => p.category?.toLowerCase() === 'people' || p.categories?.some((c: string) => c.toLowerCase() === 'people')).length || 2 },
  { name: 'Opinions', slug: 'opinions', icon: '💡', count: posts.filter(p => p.category?.toLowerCase() === 'opinions' || p.categories?.some((c: string) => c.toLowerCase() === 'opinions')).length || 2 },
];
---

<Layout 
  title="tiwantiwa — Stories, ideas and conversations about Nigeria and Nigerians everywhere."
  description="Tiwantiwa is an independent digital magazine telling stories about Nigeria, its diaspora, culture, ideas, and people."
>

  <main class="min-h-screen">

    <!-- Hero / Brand Introduction -->
    <section class="relative overflow-hidden bg-gradient-to-b from-zinc-950 via-zinc-950 to-zinc-950 border-b border-zinc-800/60">
      <div class="absolute inset-0 opacity-[0.04]">
        <svg width="100%" height="100%" xmlns="http://www.w3.org/2000/svg">
          <defs>
            <pattern id="dotGrid" width="30" height="30" patternUnits="userSpaceOnUse">
              <circle cx="2" cy="2" r="0.6" fill="#f59e0b" />
            </pattern>
          </defs>
          <rect width="100%" height="100%" fill="url(#dotGrid)" />
        </svg>
      </div>

      <div class="relative max-w-5xl mx-auto px-5 sm:px-8 pt-20 pb-14 text-center space-y-7">
        <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-amber-500/10 border border-amber-500/15 text-amber-300 text-[11px] font-mono uppercase tracking-[0.15em]">
          <span>Independent Digital Publication</span>
        </div>
        <h1 class="text-5xl sm:text-7xl lg:text-8xl font-serif font-bold text-white tracking-tight leading-[0.92]">
          tiwantiwa
        </h1>
        <p class="text-xl sm:text-2xl lg:text-3xl font-serif text-zinc-300 italic leading-relaxed max-w-3xl mx-auto">
          Stories, ideas and conversations about Nigeria and Nigerians everywhere.
        </p>
        <div class="flex flex-wrap items-center justify-center gap-x-4 gap-y-2 text-[11px] uppercase tracking-[0.12em] text-zinc-500 font-mono">
          <span>Stories</span><span class="text-zinc-700">/</span>
          <span>Culture</span><span class="text-zinc-700">/</span>
          <span>Business</span><span class="text-zinc-700">/</span>
          <span>Technology</span><span class="text-zinc-700">/</span>
          <span>Diaspora</span><span class="text-zinc-700">/</span>
          <span>People</span>
        </div>
      </div>
    </section>

    <div class="max-w-7xl mx-auto px-5 sm:px-8 py-16 sm:py-24 space-y-24">

      <!-- Featured Story -->
      {featuredPost && (
      <section aria-label="Featured story" class="space-y-8">
        <div class="flex items-end justify-between border-b border-zinc-800 pb-3">
          <h2 class="text-[10px] uppercase tracking-[0.2em] font-sans font-bold text-zinc-500">Editor's Pick</h2>
          <a href={`/posts/${featuredPost.slug}/`} class="text-[10px] uppercase tracking-[0.15em] font-sans text-zinc-400 hover:text-amber-300 transition-colors">Read Full Story &rarr;</a>
        </div>

        <a href={`/posts/${featuredPost.slug}/`} class="block group">
          <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-10 items-start">
            <div class="lg:col-span-7 space-y-6">
              <span class="text-[11px] uppercase tracking-[0.1em] font-mono font-semibold text-amber-400">{featuredPost.categories?.[0] || featuredPost.category || 'Nigeria'}</span>
              <h3 class="text-3xl sm:text-4xl lg:text-[2.75rem] font-serif font-bold text-white tracking-tight leading-[1.1] group-hover:text-amber-300 transition-colors duration-300">
                {featuredPost.title}
              </h3>
              <p class="text-zinc-300 text-base sm:text-lg leading-[1.7] max-w-prose">
                {featuredPost.description}
              </p>
              <div class="flex items-center gap-5 text-[11px] uppercase tracking-[0.08em] font-sans text-zinc-500">
                <span>By <strong class="text-white font-medium">{featuredPost.author || 'Editorial Board'}</strong></span>
                <span class="w-1 h-1 rounded-full bg-zinc-700"></span>
                <span>{new Date(featuredPost.date).toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric' })}</span>
              </div>
            </div>
            <div class="lg:col-span-5 relative">
              <a href={`/posts/${featuredPost.slug}/`} class="block relative overflow-hidden rounded-2xl bg-gradient-to-br from-zinc-900 to-zinc-950 aspect-[4/3] group">
                <img 
                  src="/images/{featuredPost.slug}.jpg" 
                  alt={featuredPost.title} 
                  class="w-full h-full object-cover opacity-80 group-hover:scale-[1.04] transition-transform duration-700"
                  loading="eager"
                  onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';"
                />
                <div class="absolute inset-0 flex items-center justify-center opacity-0 group-hover:opacity-100 transition-opacity duration-300 bg-zinc-950/30 backdrop-blur-[2px] z-10" style="display:none;">
                  <span class="text-xs uppercase tracking-[0.15em] font-mono text-white border border-white/30 px-4 py-2 rounded-full">Read Story</span>
                </div>
                <div class="absolute bottom-4 left-4 z-10">
                  <span class="inline-block px-2.5 py-1 bg-amber-400 text-zinc-950 text-[10px] font-bold uppercase tracking-wider rounded-md shadow-lg shadow-amber-500/20">Featured</span>
                </div>
              </a>
            </div>
          </div>
        </a>
      </section>
      )}

      <!-- Latest Stories -->
      <section aria-label="Latest stories" class="space-y-7">
        <div class="flex items-end justify-between border-b border-zinc-800 pb-3 gap-4">
          <h2 class="text-lg font-serif font-bold tracking-tight text-white">Latest Stories</h2>
          <a href="/" class="text-[10px] uppercase tracking-[0.12em] font-sans text-zinc-500 hover:text-zinc-300 transition-colors hidden sm:inline">View All &rarr;</a>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
          {recentPosts.map((post: any) => (
            <article class="flex flex-col bg-zinc-900/30 border border-zinc-800/70 rounded-2xl overflow-hidden hover:border-zinc-700 hover:-translate-y-1 transition-all duration-300 group">
              <a href={`/posts/${post.slug}/`} class="block relative overflow-hidden bg-zinc-900 aspect-[16/10]">
                <img 
                  src="/images/{post.slug}.jpg" 
                  alt={post.title} 
                  class="w-full h-full object-cover opacity-90 group-hover:scale-[1.06] transition-transform duration-700 group-hover:brightness-110"
                  loading="lazy"
                  onerror="this.style.display='none'; this.parentElement.style.background='linear-gradient(to bottom right, #18181b, #27272a)';"
                />
                <div class="absolute bottom-3 left-3 z-10">
                  <span class="inline-block px-2 py-0.5 bg-black/60 backdrop-blur-sm text-[9px] font-mono font-bold uppercase tracking-wider text-amber-300 rounded-md border border-amber-600/20">
                    {post.categories?.[0] || post.category || 'Dispatch'}
                  </span>
                </div>
              </a>
              <div class="p-6 flex-1 flex flex-col">
                <h3 class="text-lg font-serif font-bold text-white tracking-tight leading-snug group-hover:text-amber-300 transition-colors mb-3">
                  <a href={`/posts/${post.slug}/`} class="focus:outline-none">
                    {post.title}
                  </a>
                </h3>
                <p class="text-[13px] text-zinc-400 leading-relaxed line-clamp-3 mb-4 flex-grow">
                  {post.description}
                </p>
                <div class="flex items-center justify-between pt-4 border-t border-zinc-800/50 text-[11px] text-zinc-500 font-sans uppercase tracking-wider">
                  <span>{post.author || 'Editorial Board'}</span>
                  <span class="font-mono text-[10px]">{new Date(post.date).toLocaleDateString('en-US', { month: 'long', year: 'numeric' })}</span>
                </div>
              </div>
            </article>
          ))}
        </div>
      </section>

      <!-- Categories -->
      <section aria-label="Editorial categories" class="space-y-6">
        <div class="flex items-end justify-between border-b border-zinc-800 pb-3 gap-4">
          <h2 class="text-xs uppercase tracking-[0.2em] font-sans font-bold text-zinc-500">Browse Sections</h2>
          <span class="text-[10px] font-mono text-zinc-600">{categories.length} Editorial Areas</span>
        </div>
        <div class="grid grid-cols-2 sm:grid-cols-4 lg:grid-cols-8 gap-3">
          {categories.map((cat) => (
            <a href={`/category/${cat.slug}`} class="group relative flex flex-col items-center justify-center gap-3 bg-zinc-900/20 border border-zinc-800/60 rounded-2xl p-6 hover:border-amber-400/40 hover:bg-zinc-900/60 transition-all duration-300 text-center h-full min-h-[9rem] focus:outline-none focus:ring-2 focus:ring-amber-400/30">
              <span class="text-3xl sm:text-4xl group-hover:scale-110 transition-transform duration-300">{cat.icon}</span>
              <div class="space-y-0.5">
                <span class="block text-sm font-bold text-white group-hover:text-amber-300 transition-colors tracking-tight">{cat.name}</span>
                <span class="block text-[10px] font-mono text-zinc-600">{cat.count} Story</span>
              </div>
            </a>
          ))}
        </div>
      </section>

      <!-- Subscribe -->
      <section id="subscribe" aria-label="Subscribe" class="rounded-2xl border border-zinc-800 bg-gradient-to-r from-zinc-900 to-zinc-950/70 p-8 sm:p-12 text-center space-y-5">
        <div class="max-w-xl mx-auto space-y-2">
          <h3 class="text-2xl sm:text-3xl font-serif font-bold text-white tracking-tight">The Tiwantiwa Dispatch</h3>
          <p class="text-sm text-zinc-400 leading-relaxed">Unflinching journalism, cultural insights, and diaspora business intelligence from Nigeria across the world.</p>
        </div>
        <form onsubmit="event.preventDefault(); this.innerHTML='<p class=\'text-sm font-semibold text-amber-300\'>Subscribed. Check your inbox.</p>';" class="max-w-md mx-auto flex flex-col sm:flex-row gap-3">
          <input type="email" required placeholder="Enter your work email" class="flex-grow bg-zinc-950 border border-zinc-700 rounded-full px-5 py-3 text-sm text-white placeholder-zinc-500 focus:outline-none focus:border-amber-400 transition-colors" />
          <button type="submit" class="px-6 py-3 rounded-full bg-amber-400 text-zinc-950 font-sans font-bold text-xs uppercase tracking-widest hover:bg-amber-300 transition-all shadow-lg shadow-amber-400/10">
            Subscribe
          </button>
        </form>
      </section>

    </div>

  </main>
</Layout>