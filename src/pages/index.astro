---
import Layout from '../components/Layout.astro';

const postsGlob = import.meta.glob('../content/published/*.md', { eager: true });
const posts = Object.entries(postsGlob).map(([path, post]: [string, any]) => {
  const slug = path.split('/').pop()?.replace('.md', '') || '';
  return {
    slug,
    ...post.frontmatter,
  };
}).sort((a: any, b: any) => new Date(b.date).getTime() - new Date(a.date).getTime());

const featuredPost = posts[0];
const recentPosts = posts.slice(1);
---

<Layout title="tiwantiwa — Enterprise Digital Magazine">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10">
    
    <!-- Hero Featured Grid -->
    {featuredPost && (
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 mb-16 pb-16 border-b border-zinc-800">
        <div class="lg:col-span-7 flex flex-col justify-center space-y-6">
          <div class="flex items-center gap-3 text-xs font-semibold uppercase tracking-widest text-amber-400">
            <span>{featuredPost.categories?.[0] || featuredPost.category || 'Featured'}</span>
            <span class="text-zinc-600">&bull;</span>
            <span>{new Date(featuredPost.date).toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric' })}</span>
            <span class="text-zinc-600">&bull;</span>
            <span class="text-zinc-400 font-mono text-[11px]">~4 min read</span>
          </div>
          <h1 class="text-3xl sm:text-5xl font-serif font-bold text-white tracking-tight leading-tight">
            <a href={`/posts/${featuredPost.slug}/`} class="hover:text-amber-400 transition-colors">
              {featuredPost.title}
            </a>
          </h1>
          <p class="text-zinc-300 text-base sm:text-lg leading-relaxed line-clamp-3">
            {featuredPost.description}
          </p>
          <div class="pt-2 flex items-center justify-between">
            <span class="text-xs uppercase tracking-wider text-zinc-500 font-sans">
              By <strong class="text-zinc-300">{featuredPost.author}</strong>
            </span>
            <a href={`/posts/${featuredPost.slug}/`} class="text-xs uppercase tracking-widest text-amber-400 font-semibold hover:text-amber-300 transition-colors">
              Read Dispatch &rarr;
            </a>
          </div>
        </div>

        <!-- Conway's Game of Life Live Widget replacing static cover -->
        <div class="lg:col-span-5 h-80 sm:h-96 rounded-xl bg-gradient-to-br from-zinc-900 to-zinc-950 border border-zinc-800 flex flex-col items-center justify-center relative overflow-hidden group p-8 text-center space-y-4">
          <div class="absolute top-3 left-3 z-10 flex items-center gap-2 px-2.5 py-1 rounded bg-zinc-950/80 border border-zinc-800 text-[10px] font-mono text-amber-400">
            <span class="w-1.5 h-1.5 rounded-full bg-amber-400 animate-pulse"></span>
            <span>SYSTEM: EDGE_NODE_SECURE</span>
          </div>
          <div class="space-y-2">
            <span class="text-xs font-mono uppercase tracking-widest text-amber-400">tiwantiwa.com v3.2</span>
            <h3 class="text-2xl font-serif font-bold text-white tracking-tight">Autonomous Edge Publisher</h3>
            <p class="text-xs text-zinc-400 max-w-sm mx-auto leading-relaxed">
              Zero-cost static architecture hooked directly to automated markdown ingestion, editorial approval pipelines, and cryptographic sitemaps.
            </p>
          </div>
          <div class="pt-2 flex items-center gap-2 text-[10px] font-mono text-zinc-500">
            <span class="px-2 py-1 rounded bg-zinc-900 border border-zinc-800">Astro 4</span>
            <span class="px-2 py-1 rounded bg-zinc-900 border border-zinc-800">Tailwind v4</span>
            <span class="px-2 py-1 rounded bg-zinc-900 border border-zinc-800">Zero SaaS Cost</span>
          </div>
        </div>
      </div>
    )}

    <!-- Recent Dispatches & Game of Life Section -->
    <div class="space-y-8">
      <div class="flex items-center justify-between border-b border-zinc-800 pb-4">
        <h2 class="text-xl font-bold uppercase tracking-wider font-serif text-white">Recent Dispatches</h2>
        <span class="text-xs text-zinc-500 font-mono">AUTONOMOUS ENGINE v3.2</span>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
        {recentPosts.map((post: any) => (
          <article class="flex flex-col justify-between p-6 rounded-2xl bg-zinc-900/40 border border-zinc-800/80 hover:border-zinc-700 transition-all group">
            <div class="space-y-4">
              <div class="flex items-center justify-between text-xs font-semibold uppercase tracking-widest text-amber-400">
                <span>{post.categories?.[0] || post.category || 'Dispatch'}</span>
                <span class="text-zinc-600">&bull;</span>
                <span class="text-zinc-400 font-mono text-[11px]">~3 min read</span>
              </div>
              <h3 class="text-xl font-serif font-bold text-white group-hover:text-amber-300 transition-colors">
                <a href={`/posts/${post.slug}/`}>
                  {post.title}
                </a>
              </h3>
              <p class="text-sm text-zinc-400 leading-relaxed line-clamp-3">
                {post.description}
              </p>
            </div>
            <div class="pt-6 mt-6 border-t border-zinc-800/60 flex items-center justify-between text-xs text-zinc-500">
              <span>{post.author}</span>
              <a href={`/posts/${post.slug}/`} class="text-amber-400 font-semibold hover:text-amber-300">
                Read &rarr;
              </a>
            </div>
          </article>
        ))}
      </div>
    </div>

  </div>


</Layout>
