---
import Layout from '../components/Layout.astro';
---

<Layout 
  title="Contact Us — tiwantiwa" 
  description="Get in touch with the tiwantiwa editorial board, submit news tips, or pitch guest essays."
>
  <article class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-16">
    <div class="space-y-6 text-center max-w-3xl mx-auto mb-12">
      <h1 class="text-4xl sm:text-6xl font-serif font-bold text-white tracking-tight leading-tight">
        Contact the Board
      </h1>
      <p class="text-lg sm:text-xl text-zinc-400 leading-relaxed font-serif italic">
        Send news tips, editorial pitches, or inquiries to our team.
      </p>
    </div>

    <div class="prose prose-invert prose-amber max-w-none font-serif text-lg leading-relaxed text-zinc-300 space-y-6">
      <p>
        Whether you are a startup founder in Lagos, a diaspora professional with a compelling venture story, or a reader with feedback, we want to hear from you.
      </p>

      <h2>Editorial & News Tips</h2>
      <p>
        Secure story pitches, press releases, and confidential news tips can be directed to our editorial board at <a href="mailto:editor@tiwantiwa.com" class="text-amber-400 underline">editor@tiwantiwa.com</a>.
      </p>

      <h2>Partnerships & Advertising</h2>
      <p>
        For inquiries regarding sponsorships, verified affiliate integrations, or institutional partnerships, reach out via <a href="mailto:partners@tiwantiwa.com" class="text-amber-400 underline">partners@tiwantiwa.com</a>.
      </p>
    </div>

    <div class="mt-16 pt-8 border-t border-zinc-800 flex items-center justify-between">
      <a href="/" class="text-xs uppercase tracking-widest text-amber-400 hover:text-amber-300 font-semibold transition-colors">
        &larr; Back to Feed
      </a>
      <span class="text-xs uppercase tracking-wider text-zinc-500 font-sans">
        tiwantiwa.com
      </span>
    </div>
  </article>
</Layout>
